          { "text": "User persona is {{persona}} — field operations depend on rain" },
          { "text": "Rain probability is {{rainProbability}}% under {{conditionLabel}}" },
          { "text": "Accumulation of {{precipitation}} mm raises waterlogging risk", "when": { "precipitation": { "gte": 8 } } },
          { "text": "Humidity {{humidity}}% slows drying for spray operations", "when": { "humidity": { "gte": 75 } } }
        ]
      }
