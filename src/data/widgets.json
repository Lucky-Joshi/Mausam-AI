{
  "widgets": [
    {
      "id": "running-score",
      "personas": ["runner"],
      "label": "Running Score",
      "icon": "gauge",
      "type": "gauge",
      "unit": "/100",
      "size": "wide",
      "accent": "#2563eb",
      "source": "Mausam Activity Scorer v2.1",
      "compute": {
        "kind": "score",
        "base": 78,
        "factors": [
          { "metric": "aqi", "weight": -26, "low": 20, "high": 200 },
          { "metric": "rainProbability", "weight": -24, "low": 10, "high": 90 },
          { "metric": "temperature", "weight": 20, "optimum": 22, "tolerance": 15 },
          { "metric": "humidity", "weight": -12, "low": 30, "high": 85 },
          { "metric": "wind", "weight": -10, "low": 8, "high": 40 },
          { "metric": "uv", "weight": -8, "low": 4, "high": 11 }
        ]
      },
      "why": {
        "headline": "Running suitability blends six live factors into a single 0–100 score.",
        "confidence": 94,
        "factors": [
          { "text": "User persona is {{persona}}" },
          { "text": "AQI is {{aqi}} ({{aqiLabel}}) — airway load is the largest single penalty", "when": { "aqi": { "gte": 80 } } },
          { "text": "Rain probability {{rainProbability}}% with {{conditionLabel}} conditions", "when": { "rainProbability": { "gte": 30 } } },
          { "text": "Temperature {{temperature}}°C sits near the {{idealWindow}} comfort optimum" },
          { "text": "Humidity {{humidity}}% reduces evaporative cooling", "when": { "humidity": { "gte": 70 } } },
          { "text": "Wind {{wind}} km/h is workable for {{persona}}", "when": { "wind": { "lt": 28 } } },
          { "text": "UV {{uv}} at {{timeOfDayLabel}} needs sunscreen after 40 minutes", "when": { "uv": { "gte": 6 } } }
        ]
      }
    },
    {
      "id": "runner-aqi",
      "personas": ["runner"],
      "label": "Air Quality",
      "icon": "wind",
      "type": "band",
      "unit": " AQI",
      "size": "normal",
      "accent": "#0ea5a4",
      "source": "CPCB AQI station feed",
      "compute": { "kind": "band", "metric": "aqi", "bandKey": "aqi" },
      "why": {
        "headline": "Breathing comfort is the deciding factor for every outdoor run.",
        "confidence": 97,
        "factors": [
          { "text": "User persona is {{persona}} — breathing load is critical" },
          { "text": "AQI is {{aqi}} which maps to {{aqiLabel}}" },
          { "text": "Outdoor activity is directly affected by particulate load", "when": { "aqi": { "gte": 100 } } },
          { "text": "Rain is washing out particulates, keeping AQI favourable", "when": { "aqi": { "lt": 80 } } }
        ]
      }
    },
    {
      "id": "runner-sunrise",
      "personas": ["runner"],
      "label": "Sunrise",
      "icon": "sunrise",
      "type": "stat",
      "unit": "",
      "size": "normal",
      "accent": "#f59e0b",
      "source": "Astronomical almanac",
      "compute": { "kind": "astro", "field": "sunrise" },
      "why": {
        "headline": "Sunrise anchors the highest-quality running window of the day.",
        "confidence": 99,
        "factors": [
          { "text": "User persona is {{persona}} — dawn runs score best" },
          { "text": "Sunrise for {{location}} is {{sunrise}} local time" },
          { "text": "Air quality is at its daily minimum around {{sunrise}}", "when": { "aqi": { "gte": 80 } } }
        ]
      }
    },
    {
      "id": "runner-wind",
      "personas": ["runner"],
      "label": "Wind Load",
      "icon": "gauge",
      "type": "band",
      "unit": " km/h",
      "size": "normal",
      "accent": "#38bdf8",
      "source": "IMD surface station",
      "compute": { "kind": "band", "metric": "wind", "bandKey": "wind" },
      "why": {
        "headline": "Wind drives convective cooling and, above 25 km/h, running economy loss.",
        "confidence": 91,
        "factors": [
          { "text": "User persona is {{persona}} — headwind cost is tracked" },
          { "text": "Sustained wind is {{wind}} km/h ({{windLabel}})" },
          { "text": "Gusts above 25 km/h reduce pace by 4–7% for a {{persona}}", "when": { "wind": { "gte": 25 } } }
        ]
      }
    },
    {
      "id": "runner-uv",
      "personas": ["runner"],
      "label": "UV Exposure",
      "icon": "sun-medium",
      "type": "band",
      "unit": " UV",
      "size": "normal",
      "accent": "#f97316",
      "source": "CPCB UV index model",
      "compute": { "kind": "band", "metric": "uv", "bandKey": "uv" },
      "why": {
        "headline": "UV sets the safe duration of a run before skin damage.",
        "confidence": 93,
        "factors": [
          { "text": "User persona is {{persona}} — prolonged skin exposure" },
          { "text": "UV index is {{uv}} ({{uvLabel}}) at {{timeOfDayLabel}}" },
          { "text": "Time of day {{timeOfDayLabel}} adds {{timeOfDayNote}}", "when": { "uv": { "gte": 5 } } }
        ]
      }
    },
    {
      "id": "runner-window",
      "personas": ["runner"],
      "label": "Best Run Window",
      "icon": "timer",
      "type": "advisory",
      "unit": "",
      "size": "wide",
      "accent": "#6366f1",
      "source": "Mausam Window Optimiser v1.4",
      "compute": {
        "kind": "state",
        "states": [
          {
            "id": "storm-block",
            "when": { "condition": ["thunderstorm", "heavy-rain"] },
            "value": "Blocked",
            "label": "No safe window",
            "detail": "{{conditionLabel}} with {{wind}} km/h wind. Lightning and flash flooding make outdoor running unsafe.",
            "tone": "danger",
            "confidence": 98
          },
          {
            "id": "air-block",
            "when": { "aqi": { "gte": 200 } },
            "value": "Indoor only",
            "label": "Air quality hazard",
            "detail": "AQI {{aqi}} ({{aqiLabel}}). Run on a treadmill or wait for ventilation to improve.",
            "tone": "danger",
            "confidence": 96
          },
          {
            "id": "rain-block",
            "when": { "rainProbability": { "gte": 60 } },
            "value": "Postpone",
            "label": "Rain likely",
            "detail": "{{rainProbability}}% rain probability. Shift the session to avoid soaked surfaces and lightning risk.",
            "tone": "warning",
            "confidence": 94
          },
          {
            "id": "heat-shift",
            "when": { "temperature": { "gte": 35 } },
            "value": "{{sunrise}} + 20 min",
            "label": "Move to dawn",
            "detail": "{{temperature}}°C is unsafe for effort running. Run at first light instead.",
            "tone": "warning",
            "confidence": 95
          },
          {
            "id": "uv-shift",
            "when": { "uv": { "gte": 9 }, "timeOfDay": ["afternoon"] },
            "value": "{{sunrise}} + 25 min",
            "label": "High UV at {{timeOfDayLabel}}",
            "detail": "UV {{uv}} at {{timeOfDayLabel}}. Sunscreen mandatory and shade breaks every 20 minutes.",
            "tone": "warning",
            "confidence": 92
          },
          {
            "id": "quality",
            "when": { "aqi": { "lt": 80 } },
            "value": "{{idealWindow}}",
            "label": "Ideal window",
            "detail": "AQI {{aqi}}, {{temperature}}°C, {{rainProbability}}% rain. Optimal conditions for {{persona}}.",
            "tone": "success",
            "confidence": 96
          }
        ],
        "fallback": {
          "id": "acceptable",
          "when": {},
          "value": "Short session",
          "label": "Acceptable with care",
          "detail": "Conditions are mixed. Keep the effort easy and re-check AQI before the session.",
          "tone": "info",
          "confidence": 90
        }
      },
      "why": {
        "headline": "The best window is the first time slot that clears every hard constraint.",
        "confidence": 93,
        "factors": [
          { "text": "User persona is {{persona}} with an ideal window of {{idealWindow}}" },
          { "text": "Hard block: {{conditionLabel}} produces lightning and flooding risk", "when": { "condition": ["thunderstorm", "heavy-rain"] } },
          { "text": "Hard block: AQI {{aqi}} exceeds the safe exposure limit", "when": { "aqi": { "gte": 200 } } },
          { "text": "Soft block: {{rainProbability}}% rain probability", "when": { "rainProbability": { "gte": 60 } } },
          { "text": "Soft block: {{temperature}}°C heat stress", "when": { "temperature": { "gte": 35 } } },
          { "text": "Sunrise for {{location}} is {{sunrise}}" }
        ]
      }
    },

    {
